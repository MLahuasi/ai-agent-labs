# Copia este archivo como .env y agrega tus API keys reales
# NUNCA commitees el archivo .env

# ====== LLMS SETTINGS ======
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo de Anthropic a usar (opciones: claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo de OpenAI a usar (opciones: gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini
# OTROS CLIENTES
# GEMINI
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-2.5-flash-lite
# GROQ
GROQ_API_KEY=xxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
# OLLAMA
OLLAMA_HOST=http://localhost:11434
# Buscar opciones que usen  tools o no dependiendo de recursos del equipo 
OLLAMA_MODEL=qwen2.5-coder:3b


# === CONFIGURACIÓN DEL MODELO ===
# Opciones: anthropic | openai | gemini | groq | ollama
MODEL_PROVIDER=anthropic
# Numero Maximo de Tokens
MAX_TOKENS= 1024
# Imprimir logs respuestas llms
PRINT_LOGS=true


# === RAG ===
# Modelo de embeddings de OpenAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Directorio donde está la documentación a indexar
DOCS_PATH=./docs/sample-docs
# Ruta a la base de datos de vectores
DB_PATH=./data/vectors.db
# Número de chunks a recuperar por búsqueda
RAG_TOP_K=5
# Separador de secciones del archivo
SEPARATOR= "##"
# Extension de archivo que se usará en RAG
EXTENTION= .md
# Tamaño del Chunk
TARGET_CHUNK_SIZE=2000
# Se usa para definir un porcentaje +- de extensión de un RAG
CHUNK_SIZE_TOLERANCE=0.1

# === TOOLS ===
# Evita ciclos indefinidos cuando el modelo solicita herramientas repetidamente.
MAX_ITERATIONS=10
# Limita el número máximo de tools ejecutadas
MAX_TOOL_CALLS=8
# Numero Maximo de Tokens
MAX_TOKENS_TOOLS= 4096


