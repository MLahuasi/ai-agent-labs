{
  "name": "dev-assistant",
  "version": "0.1.0",
  "description": "Asistente inteligente de documentación técnica con RAG, function Calling y LLMs API (Claude, OpenAI, Groq, Gemini, Ollama)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "review": "tsx src/exercises/code-reviewer.ts",
    "ingest": "tsx src/rag/ingest/ingest.cli.ts",
    "agent": "tsx src/labs/agent/init.cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "claude",
    "openai",
    "rag",
    "function-calling"
  ],
  "author": "MLahuasi",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/genai": "^2.12.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.3.1",
    "groq-sdk": "^1.4.0",
    "ollama": "^0.6.3",
    "openai": "^6.32.0",
    "readline": "^1.3.0",
    "sqlite-vec": "^0.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.5.0"
  }
}
